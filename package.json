{
  "name": "pvd311",
  "private": true,
  "scripts": {
    "dev": "npx serve -l 3999 --no-clipboard public",
    "test": "cd public && npx playwright test",
    "build": "cd automation && npm run build",
    "deploy": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:all": "firebase deploy --only hosting,firestore:rules,storage",
    "dashboard": "cd automation && npm start",
    "test:rules": "firebase emulators:exec --only firestore,storage --project pvd311-rules-test 'node tests/rules/firestore.rules.test.mjs'"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
